     RowBox[{
     "Resolution", " ", "Parallel", " ", "Grid", " ", "Generation"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gridData", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]Val", ",", "\[Lambda]Val", ",", 
