Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Tf", "=", "15.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numSims", " ", "=", " ", "1000"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"getData", "[", 
     RowBox[{
     "\[CapitalDelta]1_", ",", "\[CapitalDelta]2_", ",", " ", "\[Epsilon]_", ",",
       " ", "\[Lambda]_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "left", ",", " ", "right", ",", " ", "sims", ",", " ", "tab", ",", "f",
         ",", "g", ",", " ", "Simulate2"}], "}"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "x_", "]"}], "=", 
        RowBox[{"x", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "x"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"\[CapitalDelta]2", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[CapitalDelta]1", "-", "\[CapitalDelta]2"}], ")"}], " ",
             "x"}]}], ")"}]}]}], ";", "\n", "       ", 
       RowBox[{
        RowBox[{"g", "[", "x_", "]"}], "=", 
        RowBox[{"x", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "x"}], ")"}], "*", "\[Epsilon]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Simulate2", "=", 
        RowBox[{"ParametricNDSolve", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"y", "'"}], "[", "t", "]"}], "==", 
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{"y", "[", "t", "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"\[Xi]", "[", "t", "]"}], "*", 
               RowBox[{"g", "[", 
                RowBox[{"y", "[", "t", "]"}], "]"}]}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"h", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"2", "*", "\[Lambda]67"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"h", "[", "t", "]"}], ">=", 
               RowBox[{"tn", "[", "t", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Xi]", "[", "t", "]"}], "->", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"RandomReal", "[", "]"}], "<=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", "\[Delta]"}], ")"}], "/", "2"}]}], ",", 
                   RowBox[{"-", "1"}], ",", "1"}], "]"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"h", "[", "t", "]"}], "->", "0"}], ",", 
                RowBox[{
                 RowBox[{"tn", "[", "t", "]"}], "->", 
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{"ExponentialDistribution", "[", "1", "]"}], 
                  "]"}]}]}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"tn", "[", "0", "]"}], "==", " ", "tn0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"y", "[", "0", "]"}], "==", "y0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"h", "[", "0", "]"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"\[Xi]", "[", "0", "]"}], "==", "\[Xi]0"}]}], "}"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"y", ",", "h", ",", " ", "\[Xi]"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "Tf"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "y0", ",", "\[Xi]0", ",", "\[Lambda]67", ",", "\[Delta]", ",", " ",
             "tn0"}], "}"}], ",", 
          RowBox[{"(*", "parameters", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"DiscreteVariables", "->", 
           RowBox[{"{", 
            RowBox[{"\[Xi]", ",", "tn"}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"left", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]2", "-", "\[Epsilon]"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]2", "-", "\[CapitalDelta]1"}], ")"}]}], "+", 
         RowBox[{"10", "^", 
          RowBox[{"-", "4"}]}]}]}], ";", "\n", "\t", 
       RowBox[{"right", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]2", "+", "\[Epsilon]"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]2", "-", "\[CapitalDelta]1"}], ")"}]}], "-", 
         RowBox[{"10", "^", 
          RowBox[{"-", "4"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sims", " ", "=", " ", 
        RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", "[", 
             RowBox[{
              RowBox[{"RandomReal", "[", "]"}], ",", " ", 
              RowBox[{"RandomChoice", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}], ",", " ", 
              "\[Lambda]", ",", " ", "0", " ", ",", " ", 
              RowBox[{"RandomVariate", "[", 
               RowBox[{"ExponentialDistribution", "[", "1", "]"}], "]"}]}], 
             "]"}], ")"}], " ", "/.", " ", "Simulate2"}], ",", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"{", "numSims", "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tab", " ", "=", " ", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", " ", 
            RowBox[{
             RowBox[{"sims", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}]}], "}"}], ",", 
          " ", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"t", ",", " ", "0", ",", " ", "Tf", ",", " ", 
            RowBox[{"Tf", "/", "100"}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", "numSims"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", "tab", "]"}]}]}], "\[IndentingNewLine]", " ",
      "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data1", " ", "=", " ", 
     RowBox[{"getData", "[", 
      RowBox[{
      "\[CapitalDelta]1", ",", "\[CapitalDelta]2", ",", " ", "\[Epsilon]", ",",
        " ", "\[Lambda]1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data2", " ", "=", " ", 
     RowBox[{"getData", "[", 
      RowBox[{
      "\[CapitalDelta]1", ",", " ", "\[CapitalDelta]2", ",", " ", 
       "\[Epsilon]", ",", " ", "\[Lambda]2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data3", " ", "=", " ", 
     RowBox[{"getData", "[", 
      RowBox[{
      "\[CapitalDelta]1", ",", " ", "\[CapitalDelta]2", ",", " ", 
       "\[Epsilon]", ",", " ", "\[Lambda]3"}], "]"}]}], ";"}]}]}]], "Input",
