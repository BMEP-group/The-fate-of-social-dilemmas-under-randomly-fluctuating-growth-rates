Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RunSimulationHist", "[", 
     RowBox[{"paramsList_", ",", 
      RowBox[{"numInvocations_", ":", "Integer"}], ",", 
      RowBox[{"xlow_", ":", "NumericQ"}], ",", 
      RowBox[{"xhigh_", ":", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "lines", ",", "inputString", ",", "output", ",", "ys", ",", "asd"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"lines", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"StringRiffle", "[", 
            RowBox[{
             RowBox[{"ToString", "/@", 
              RowBox[{"Join", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"numInvocations", ",", 
                  RowBox[{"N", "[", "xlow", "]"}], ",", 
                  RowBox[{"N", "[", "xhigh", "]"}]}], "}"}]}], "]"}]}], 
             ",", "\"\< \>\""}], "]"}], "&"}], ")"}], "/@", "paramsList"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"inputString", "=", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{"lines", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"Length", "[", "paramsList", "]"}], "]"}]}], "]"}], 
          ",", "\"\<\\n\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"output", "=", 
        RowBox[{"RunProcess", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<wsl\>\"", ",", 
            " ", "\"\<~/projects/kinetic/bin/pdmp_example\>\""}], "}"}], 
          ",", "\"\<StandardOutput\>\"", ",", "inputString"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"asd", "=", 
        RowBox[{"StringSplit", "[", 
         RowBox[{"StringTrim", "[", "output", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ys", "=", 
        RowBox[{"Internal`StringToMReal", "/@", "asd"}]}], ";", 
       "\[IndentingNewLine]", "ys"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
