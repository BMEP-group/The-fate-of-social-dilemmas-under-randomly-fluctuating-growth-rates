             "\[CapitalDelta]1", ",", "\[CapitalDelta]2", ",", " ", 
              "\[Epsilon]", ",", "0", ",", " ", "0", ",", "\[Lambda]", ",", 
              " ", "0"}], "  ", "}"}], "}"}], ",", " ", "numInvoc", ",", " ", 
           "q", ",", " ", "q"}], "]"}]}], ";", "\[IndentingNewLine]", 
