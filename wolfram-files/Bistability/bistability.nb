Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]1", "=", "0.6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]2", "=", 
   RowBox[{"-", "1.2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]1", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"left", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]2", "+", "\[Epsilon]"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]2", "-", "\[CapitalDelta]1"}], ")"}]}], "+", 
    RowBox[{"10", "^", 
     RowBox[{"-", "6"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"right", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]2", "-", "\[Epsilon]"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"\[CapitalDelta]2", "-", "\[CapitalDelta]1"}], ")"}]}], "-", 
    RowBox[{"10", "^", 
     RowBox[{"-", "6"}]}]}]}], ";"}]}], "Input",
