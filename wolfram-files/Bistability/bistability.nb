    RowBox[{"\[Lambda]1", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]2", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]3", "=", "10.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getFrequency", "[", 
      RowBox[{"q_", ",", " ", "\[Lambda]_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", " ", "freq", ",", " ", "var"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"data", "=", " ", 
         RowBox[{"RunSimulationHist", "[", 
          RowBox[{
           RowBox[{"{", 
