Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "left", ",", " ", "right", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"right", "-", "left"}], ")"}], "/", "20"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numInvoc", "=", 
     RowBox[{"10", "^", "3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DynamicMap", "=", 
     RowBox[{"ResourceFunction", "[", "\"\<DynamicMap\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
