Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"numInvoc", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getPlotData", "[", 
      RowBox[{
      "\[Alpha]_", ",", "\[Beta]_", ",", "\[Epsilon]_", ",", "\[Delta]_", ",",
        "\[Lambda]_", ",", " ", "color_"}], "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "left", ",", " ", "right", ",", " ", "C1", ",", " ", "tab", ",", " ", 
         "tab2"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"left", "=", 
         RowBox[{"err", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Beta]", "-", "\[Epsilon]"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"\[Beta]", "-", "\[Alpha]"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"right", "=", 
         RowBox[{
          RowBox[{"-", "err"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"C1", " ", "=", " ", 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{"\[CapitalPi]as", "[", 
            RowBox[{
            "t", ",", "\[Alpha]", ",", "\[Beta]", ",", "\[Epsilon]", ",", 
             "\[Lambda]", ",", "\[Delta]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", "left", ",", "right"}], "}"}]}], "]"}]}], " ", ";",
         "\[IndentingNewLine]", 
        RowBox[{"tab", " ", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{
              RowBox[{"\[CapitalPi]as", "[", 
               RowBox[{
               "x", ",", "\[Alpha]", ",", "\[Beta]", ",", "\[Epsilon]", ",", 
                "\[Lambda]", ",", "\[Delta]"}], "]"}], "/", "C1"}]}], "}"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"x", ",", " ", "left", ",", " ", "right", ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"right", "-", "left"}], ")"}], "/", "50"}]}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tab2", " ", "=", " ", 
         RowBox[{"RunSimulationHist", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", " ", 
             RowBox[{
             "\[Alpha]", ",", "\[Beta]", ",", " ", "\[Epsilon]", ",", "1", ",",
               " ", "\[Delta]", ",", "\[Lambda]", ",", " ", "0"}], "  ", 
             "}"}], "}"}], ",", " ", "numInvoc", ",", " ", "0", ",", " ", 
           "1"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Show", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"tab", ",", " ", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", "color", "}"}]}], ",", " ", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"left", ",", " ", "right"}], "}"}], ",", "Full"}], 
              "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"SmoothHistogram", "[", 
           RowBox[{
           "tab2", ",", " ", "0.01", ",", " ", "\"\<PDF\>\"", ",", " ", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{"color", ",", " ", "Dashed"}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Frame", "->", "True"}], ",", " ", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<x - frequency\>\"", ",", 
             " ", "\"\<\!\(\*SubscriptBox[\(\[CapitalPi]\), \
\(st\(-\)\)]\)(x)-PDF\>\""}], "}"}]}], ",", " ", 
          RowBox[{"BaseStyle", "->", 
           RowBox[{"{", 
            RowBox[{"FontSize", "->", "14"}], "}"}]}], ",", " ", 
          RowBox[{"ImageSize", "->", "200"}], ",", " ", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"left", ",", " ", "right"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "6"}], "}"}]}], "}"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mShapePlot", " ", "=", " ", 
     RowBox[{"getPlotData", "[", 
      RowBox[{
      "0.1", ",", " ", "1.0", ",", " ", "0.9", ",", " ", "0", ",", " ", 
       "0.17", ",", 
