Cell[BoxData[{
 RowBox[{
  RowBox[{"tab", " ", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]", ",", 
         RowBox[{
          RowBox[{"hittime", "[", 
           RowBox[{
           "\[Alpha]", ",", " ", "1.0", ",", " ", "0.75", ",", " ", 
            "\[Lambda]"}], "]"}], " ", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "\[Lambda]", ",", " ", "0.01", ",", " ", "1.5", ",", " ", "0.01"}], 
        "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", " ", "0.1", ",", " ", "0.4", ",", " ", "0.1"}],
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tab2", " ", "=", "  ", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", 
          RowBox[{"hittime2", "[", 
           RowBox[{"\[Alpha]", ",", " ", "1.0", ",", " ", "0.75"}], "]"}]}], 
         "  ", "}"}], ",", " ", 
        RowBox[{"{", 
