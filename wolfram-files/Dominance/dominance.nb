Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "Subscript", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ml", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mr", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MFPT", "[", 
    RowBox[{
    "\[Alpha]_", ",", "\[Beta]_", ",", "\[Epsilon]_", ",", "\[Lambda]_", ",", 
     "x0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"left", ",", "right", ",", "xl", ",", "xr"}], "}"}], ",", 
     RowBox[{
      RowBox[{"left", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Beta]", "-", "\[Epsilon]"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"\[Beta]", "-", "\[Alpha]"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"right", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"xl", "=", 
       RowBox[{"left", "+", "ml"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xr", "=", 
       RowBox[{"right", "-", "mr"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", "x"}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Alpha]", "-", "\[Beta]"}], ")"}], " ", "x"}], "+",
                   "\[Beta]", "+", "\[Epsilon]"}], ")"}]}], ")"}], " ", 
              RowBox[{
               RowBox[{"Tp", "'"}], "[", "x", "]"}]}], "-", 
             RowBox[{"\[Lambda]", "*", 
              RowBox[{"Tp", "[", "x", "]"}]}], "+", 
             RowBox[{"\[Lambda]", "*", 
              RowBox[{"Tm", "[", "x", "]"}]}]}], "==", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"x", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", "x"}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"\[Alpha]", "-", "\[Beta]"}], ")"}], " ", "x"}], "+",
                   "\[Beta]", "-", "\[Epsilon]"}], ")"}]}], ")"}], " ", 
              RowBox[{
               RowBox[{"Tm", "'"}], "[", "x", "]"}]}], "+", 
             RowBox[{"\[Lambda]", "*", 
              RowBox[{"Tp", "[", "x", "]"}]}], "-", 
             RowBox[{"\[Lambda]", "*", 
              RowBox[{"Tm", "[", "x", "]"}]}]}], "==", 
            RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Tp", "[", "xr", "]"}], "==", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Tm", "[", "xl", "]"}], "==", 
            RowBox[{
             RowBox[{"1", "/", "\[Lambda]"}], "+", 
             RowBox[{"Tp", "[", "xl", "]"}]}]}]}], "\[IndentingNewLine]", 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Tp", ",", "Tm"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xl", ",", "xr"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Tp", "[", "x0", "]"}], "+", 
          RowBox[{"Tm", "[", "x0", "]"}]}], ")"}], "/", "2"}], "/.", " ", 
       "sol"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"t", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "\[Beta]"}], " ", 
     RowBox[{"Log", "[", "x", "]"}]}], "-", 
    RowBox[{
     RowBox[{"1", "/", "\[Alpha]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "-", "x"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Alpha]", "-", "\[Beta]"}], ")"}], "/", "\[Alpha]"}], "/", 
      "\[Beta]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"\[Beta]", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Alpha]", "-", "\[Beta]"}], ")"}], " ", "x"}]}], "]"}], 
      "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FPTdet", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"t", "[", 
     RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
      RowBox[{"1", "-", "mr"}]}], "]"}], "-", 
    RowBox[{"t", "[", 
     RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "x"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sample", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Beta]", "-", "\[Epsilon]"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"\[Beta]", "-", "\[Alpha]"}], ")"}]}], "+", " ", "1"}], ")"}],
     " ", "/", " ", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hittime", "[", 
    RowBox[{
    "\[Alpha]_", ",", " ", "\[Beta]_", ",", " ", "\[Epsilon]_", ",", 
     "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"MFPT", "[", 
    RowBox[{
    "\[Alpha]", ",", " ", "\[Beta]", ",", "\[Epsilon]", ",", "\[Lambda]", ",", 
     RowBox[{"sample", "[", 
      RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Epsilon]"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hittime2", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", " ", "\[Epsilon]_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"FPTdet", "[", 
    RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
     RowBox[{"sample", "[", 
      RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Epsilon]"}], "]"}]}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"7658ef9b-5ff8-0145-9af1-0a34994af599"],

