Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sz", " ", "=", " ", "250"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"graph1", " ", "=", "  ", 
  RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Lambda]", ",", 
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Epsilon]", ",", "\[Beta]"}], "}"}], ",", " ", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[Epsilon]", "=", "0.75"}], ";", "\[IndentingNewLine]", 
              RowBox[{"\[Beta]", "=", "1.0"}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
