Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"THE", " ", "HEATMAP", " ", "FOR", " ", "MFPT"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]mi", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]mx", " ", "=", "2.0"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"getMode", "[", 
      RowBox[{
      "\[CapitalDelta]1_", ",", " ", "\[CapitalDelta]2_", ",", " ", 
       "\[Epsilon]_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "tab", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"left", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]2", "-", "\[Epsilon]"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]2", "-", "\[CapitalDelta]1"}], ")"}]}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"right", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"xl", "=", 
         RowBox[{"left", "+", "ml"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xr", "=", 
         RowBox[{"right", "-", "mr"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sol2", "=", 
         RowBox[{"ParametricNDSolveValue", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", "x"}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[CapitalDelta]1", "-", "\[CapitalDelta]2"}], 
                    ")"}], " ", "x"}], "+", "\[CapitalDelta]2", "+", 
                    "\[Epsilon]"}], ")"}]}], ")"}], " ", 
                RowBox[{
                 RowBox[{"Tp", "'"}], "[", "x", "]"}]}], "-", 
               RowBox[{"\[Lambda]", "*", 
                RowBox[{"Tp", "[", "x", "]"}]}], "+", 
               RowBox[{"\[Lambda]", "*", 
                RowBox[{"Tm", "[", "x", "]"}]}]}], "==", 
              RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"x", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", "x"}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"\[CapitalDelta]1", "-", "\[CapitalDelta]2"}], 
                    ")"}], " ", "x"}], "+", "\[CapitalDelta]2", "-", 
                    "\[Epsilon]"}], ")"}]}], ")"}], " ", 
                RowBox[{
                 RowBox[{"Tm", "'"}], "[", "x", "]"}]}], "+", 
               RowBox[{"\[Lambda]", "*", 
                RowBox[{"Tp", "[", "x", "]"}]}], "-", 
               RowBox[{"\[Lambda]", "*", 
                RowBox[{"Tm", "[", "x", "]"}]}]}], "==", 
              RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Tp", "[", "xr", "]"}], "==", "0"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Tm", "[", "xl", "]"}], "==", 
              RowBox[{
               RowBox[{"1", "/", "\[Lambda]"}], "+", 
               RowBox[{"Tp", "[", "xl", "]"}]}]}]}], "\[IndentingNewLine]", 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Tp", ",", "Tm"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "xl", ",", "xr"}], "}"}], ",", "  ", 
           RowBox[{"{", "\[Lambda]", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"x0", "=", 
         RowBox[{"sample", "[", 
          RowBox[{
          "\[CapitalDelta]1", ",", " ", "\[CapitalDelta]2", ",", 
           "\[Epsilon]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tab", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"sol2", "[", "\[Lambda]", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", "x0", "]"}], "+", 
               RowBox[{
                RowBox[{
                 RowBox[{"sol2", "[", "\[Lambda]", "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "[", "x0", "]"}]}], ")"}], "/",
              "2"}], ")"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
            "\[Lambda]", ",", " ", "\[Lambda]mi", ",", " ", "\[Lambda]mx", ",",
              " ", "0.25"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OrderedQ", "[", 
           RowBox[{"tab", ",", " ", "Greater"}], "]"}], ",", " ", "0", ",", 
          " ", "1"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Beta]", "=", "2.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tab", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", " ", "\[Epsilon]", ",", " ", 
           RowBox[{"getMode", "[", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", " ", "\[Epsilon]"}], 
            "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", " ", "0.05", ",", " ", 
           RowBox[{"\[Beta]", "-", "0.1"}], ",", " ", "0.05"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Epsilon]", ",", 
           RowBox[{"\[Alpha]", "+", "0.05"}], ",", " ", 
           RowBox[{"\[Beta]", "-", "0.05"}], ",", " ", "0.05"}], "}"}]}], 
        "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colors", "=", 
     RowBox[{"{", 
      RowBox[{"White", ",", " ", "Blue", ",", "Red", ",", 
       RowBox[{"Darker", "[", "Green", "]"}], ",", "Orange"}], "}"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"discreteColor", "[", "z_", "]"}], ":=", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"z", "<=", 
        RowBox[{"-", "1"}]}], ",", " ", 
       RowBox[{"colors", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"z", "<=", "0"}], ",", 
       RowBox[{"colors", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"z", "<=", "1"}], ",", 
       RowBox[{"colors", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", 
       RowBox[{"z", "<=", "2"}], ",", 
       RowBox[{"colors", "[", 
        RowBox[{"[", "4", "]"}], "]"}], ",", 
       RowBox[{"z", "<=", "3"}], ",", 
       RowBox[{"colors", "[", 
        RowBox[{"[", "5", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"pl1", "=", 
    RowBox[{"ListDensityPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"tab", ",", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Define", " ", "the", " ", "split", " ", "at", " ", 
        "zero"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"2.", " ", "Color", " ", 
         RowBox[{"regions", ":", 
          RowBox[{
           RowBox[{"First", " ", "color", " ", "is", " ", "disc"}], "<", 
           "0"}]}]}], ",", 
        RowBox[{
         RowBox[{"Second", " ", "color", " ", "is", " ", "disc"}], ">", 
         "0"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"RegionFunction", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Beta]", ",", "\[Lambda]"}], "}"}], ",", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[Alpha]", " ", "\[Beta]"}], "+", 
                 RowBox[{"\[Alpha]", " ", "\[Epsilon]"}], "+", 
                 RowBox[{"\[Beta]", " ", "\[Epsilon]"}], "+", 
                 RowBox[{"\[Epsilon]", "^", "2"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"\[Alpha]", "-", "\[Beta]"}], ")"}]}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[Alpha]", " ", "\[Beta]"}], "-", 
                 RowBox[{"\[Alpha]", " ", "\[Epsilon]"}], "-", 
                 RowBox[{"\[Beta]", " ", "\[Epsilon]"}], "+", 
                 RowBox[{"\[Epsilon]", "^", "2"}]}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"\[Alpha]", "-", "\[Beta]"}], ")"}]}]}], "]"}], "<=", 
            "\[Lambda]", "<=", "8"}]}], "]"}]}], ","}], "*)"}], 
      RowBox[{"(*", "Aesthetics", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"InterpolationOrder", "->", "0"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(\[CapitalDelta]\), \(1\)]\)\>\"", 
         ",", "\"\<\[Epsilon]\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{"FontSize", "->", "14"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "->", "250"}], ",", "\[IndentingNewLine]", 
      RowBox[{"ColorFunction", "->", "discreteColor"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<./Documents/Dominance/DominanceHeatmapAlphaEpsilon.svg\>\"", 
     ",", " ", "pl1"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
